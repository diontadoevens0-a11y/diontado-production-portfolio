rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check endpoint (zero PII)
    match /test/connection {
      allow get: if true;
    }

    // Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedEmail() && (
        request.auth.token.email == 'amadou1966.sy@gmail.com' ||
        request.auth.token.email == 'diontadoevens.0@gmail.com'
      );
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isVerifiedEmail() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSafeMediaUrl(url) {
      return url is string &&
        url.size() >= 1 &&
        url.size() <= 2000 &&
        (
          url.matches('^https://.*') ||
          url.matches('^/api/media/[a-zA-Z0-9_.\\-]+$') ||
          url.matches('^/assets/[a-zA-Z0-9_./\\-]+$')
        );
    }

    function isOptionalSafeUrl(url) {
      return url is string &&
        url.size() <= 2000 &&
        (
          url.size() == 0 ||
          url.matches('^https://.*') ||
          url.matches('^/api/media/[a-zA-Z0-9_.\\-]+$') ||
          url.matches('^/assets/[a-zA-Z0-9_./\\-]+$')
        );
    }

    function isValidPhotoCategory(cat) {
      return cat is string && (cat == 'Soutenance' || cat == 'Photographie professionnelle');
    }

    function isValidVideoCategory(cat) {
      return cat is string && (
        cat == 'Films institutionnels' ||
        cat == 'Événementiel' ||
        cat == 'Mariage' ||
        cat == 'Clips et créations artistiques' ||
        cat == 'Reportages'
      );
    }

    function isValidAdminUser(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid == adminId && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidPortfolioPhoto(data, photoId) {
      return data.keys().hasAll([
          'id', 'title', 'description', 'category', 'albumId', 'albumTitle',
          'url', 'storagePath', 'fileName', 'mimeType', 'fileSize',
          'published', 'featured', 'sortOrder', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'category', 'albumId', 'albumTitle',
          'url', 'storagePath', 'fileName', 'mimeType', 'fileSize',
          'published', 'featured', 'sortOrder', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == photoId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.description is string && data.description.size() <= 600 &&
        isValidPhotoCategory(data.category) &&
        data.albumId is string && data.albumId.size() <= 128 &&
        data.albumTitle is string && data.albumTitle.size() <= 120 &&
        isSafeMediaUrl(data.url) &&
        data.storagePath is string && data.storagePath.size() <= 500 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255 &&
        data.mimeType is string && data.mimeType.size() <= 64 &&
        data.fileSize is int && data.fileSize >= 0 && data.fileSize <= 52428800 &&
        data.published is bool &&
        data.featured is bool &&
        data.sortOrder is int && data.sortOrder >= -100000 && data.sortOrder <= 1000000 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPortfolioAlbum(data, albumId) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'description', 'published', 'sortOrder',
          'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'category', 'description', 'published', 'sortOrder',
          'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == albumId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        isValidPhotoCategory(data.category) &&
        data.description is string && data.description.size() <= 500 &&
        data.published is bool &&
        data.sortOrder is int && data.sortOrder >= -100000 && data.sortOrder <= 1000000 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPortfolioVideo(data, videoId) {
      return data.keys().hasAll([
          'id', 'title', 'description', 'category', 'sourceType', 'youtubeId',
          'videoUrl', 'posterUrl', 'storagePath', 'isShowreel', 'published',
          'sortOrder', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'category', 'sourceType', 'youtubeId',
          'videoUrl', 'posterUrl', 'storagePath', 'isShowreel', 'published',
          'sortOrder', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == videoId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.description is string && data.description.size() <= 600 &&
        isValidVideoCategory(data.category) &&
        data.sourceType is string && (data.sourceType == 'youtube' || data.sourceType == 'mp4') &&
        data.youtubeId is string && data.youtubeId.size() <= 64 &&
        isOptionalSafeUrl(data.videoUrl) &&
        isOptionalSafeUrl(data.posterUrl) &&
        data.storagePath is string && data.storagePath.size() <= 500 &&
        data.isShowreel is bool &&
        data.published is bool &&
        data.sortOrder is int && data.sortOrder >= -100000 && data.sortOrder <= 1000000 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSiteCover(data, coverId) {
      return (coverId == 'home' || coverId == 'soutenance' || coverId == 'photographie-professionnelle' || coverId == 'apropos') &&
        data.keys().hasAll(['id', 'label', 'imageUrl', 'storagePath', 'alt', 'authorUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'label', 'imageUrl', 'storagePath', 'alt', 'authorUid', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == coverId &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        isSafeMediaUrl(data.imageUrl) &&
        data.storagePath is string && data.storagePath.size() <= 500 &&
        data.alt is string && data.alt.size() <= 250 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSiteCategoryMeta(data, catSlug) {
      return ((catSlug == 'soutenance' && data.title == 'SOUTENANCE') ||
          (catSlug == 'photographie-professionnelle' && data.title == 'PHOTOGRAPHIE PROFESSIONNELLE')) &&
        data.keys().hasAll(['slug', 'title', 'subtitle', 'description', 'authorUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['slug', 'title', 'subtitle', 'description', 'authorUid', 'createdAt', 'updatedAt']) &&
        data.slug is string && data.slug == catSlug &&
        data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 160 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 600 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSiteService(data, serviceId) {
      return data.keys().hasAll([
          'id', 'number', 'title', 'tagline', 'description', 'deliverables',
          'prestationValue', 'published', 'sortOrder', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'number', 'title', 'tagline', 'description', 'deliverables',
          'prestationValue', 'published', 'sortOrder', 'authorUid', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == serviceId &&
        data.number is string && data.number.size() >= 1 && data.number.size() <= 16 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.tagline is string && data.tagline.size() <= 160 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 800 &&
        data.deliverables is list && data.deliverables.size() <= 10 &&
        (data.deliverables.size() == 0 || data.deliverables[0] is string) &&
        data.prestationValue is string && data.prestationValue.size() >= 1 && data.prestationValue.size() <= 160 &&
        data.published is bool &&
        data.sortOrder is int && data.sortOrder >= -100000 && data.sortOrder <= 1000000 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isVerifiedEmail() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isVerifiedEmail() && isValidId(adminId) && isValidAdminUser(incoming(), adminId) &&
        incoming().createdAt == request.time && isAdmin();
      allow update: if isVerifiedEmail() && isValidId(adminId) && isValidAdminUser(incoming(), adminId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']) &&
        isAdmin();
      allow delete: if isVerifiedEmail() && isValidId(adminId) && isAdmin();
    }

    // Collection: /portfolio_photos/{photoId}
    match /portfolio_photos/{photoId} {
      allow get: if isValidId(photoId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isBootstrapAdmin();
      allow create: if isVerifiedEmail() && isValidId(photoId) && isValidPortfolioPhoto(incoming(), photoId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedEmail() && isValidId(photoId) && isValidPortfolioPhoto(incoming(), photoId) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'category', 'albumId', 'albumTitle',
          'url', 'storagePath', 'fileName', 'mimeType', 'fileSize',
          'published', 'featured', 'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedEmail() && isValidId(photoId) && isAdmin();
    }

    // Collection: /portfolio_albums/{albumId}
    match /portfolio_albums/{albumId} {
      allow get: if isValidId(albumId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isBootstrapAdmin();
      allow create: if isVerifiedEmail() && isValidId(albumId) && isValidPortfolioAlbum(incoming(), albumId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedEmail() && isValidId(albumId) && isValidPortfolioAlbum(incoming(), albumId) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'description', 'published', 'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedEmail() && isValidId(albumId) && isAdmin();
    }

    // Collection: /portfolio_videos/{videoId}
    match /portfolio_videos/{videoId} {
      allow get: if isValidId(videoId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isBootstrapAdmin();
      allow create: if isVerifiedEmail() && isValidId(videoId) && isValidPortfolioVideo(incoming(), videoId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedEmail() && isValidId(videoId) && isValidPortfolioVideo(incoming(), videoId) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'category', 'sourceType', 'youtubeId',
          'videoUrl', 'posterUrl', 'storagePath', 'isShowreel', 'published',
          'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedEmail() && isValidId(videoId) && isAdmin();
    }

    // Collection: /site_covers/{coverId}
    match /site_covers/{coverId} {
      allow get: if isValidId(coverId);
      allow list: if true;
      allow create: if isVerifiedEmail() && isValidId(coverId) && isValidSiteCover(incoming(), coverId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedEmail() && isValidId(coverId) && isValidSiteCover(incoming(), coverId) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'label', 'imageUrl', 'storagePath', 'alt', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedEmail() && isValidId(coverId) && isAdmin();
    }

    // Collection: /site_categories/{categorySlug}
    match /site_categories/{categorySlug} {
      allow get: if isValidId(categorySlug);
      allow list: if true;
      allow create: if isVerifiedEmail() && isValidId(categorySlug) && isValidSiteCategoryMeta(incoming(), categorySlug) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedEmail() && isValidId(categorySlug) && isValidSiteCategoryMeta(incoming(), categorySlug) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'subtitle', 'description', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedEmail() && isValidId(categorySlug) && isAdmin();
    }

    // Collection: /site_services/{serviceId}
    match /site_services/{serviceId} {
      allow get: if isValidId(serviceId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isBootstrapAdmin();
      allow create: if isVerifiedEmail() && isValidId(serviceId) && isValidSiteService(incoming(), serviceId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedEmail() && isValidId(serviceId) && isValidSiteService(incoming(), serviceId) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'number', 'title', 'tagline', 'description', 'deliverables',
          'prestationValue', 'published', 'sortOrder', 'updatedAt'
        ]) &&
        isAdmin();
      allow delete: if isVerifiedEmail() && isValidId(serviceId) && isAdmin();
    }
  }
}
